<Window x:Class="_106_ManagementSystemProject.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="AdminDashboardWindow" Height="1080" Width="1920">

    <Grid Margin="0,0,0,0">

        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="/pexels-thongtran95-17643093.jpg"
                        Opacity="0.9"/>
        </Grid.Background>

        <!-- Grid definition -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
   
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition />
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
            <ColumnDefinition Width="25" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Bar -->
        <Grid Background="#000807" Grid.Row="0" Grid.ColumnSpan="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="HOME"
                        Click="Home_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="ABOUT US"
                        Click="AboutUs_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="CONTACT US"
                        Click="ContactUs_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="LOGIN"
                        Click="Login_Click"/>
            </StackPanel>
        </Grid>
        
        <!-- Quick Info Balloons -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#fbf9ff"
                Padding="5"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Registered employees:</TextBox>
        </Border>
        <Border Grid.Row="2" Grid.Column="3"
                 Background="#fbf9ff"
                 Padding="5"
                 BorderBrush="Black"
                 BorderThickness="2"
                 CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Employees on leave:</TextBox>
        </Border>
        <Border Grid.Row="2" Grid.Column="5"
                 Background="#fbf9ff"
                 Padding="5"
                 BorderBrush="Black"
                 BorderThickness="2"
                 CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Pending requests:</TextBox>
        </Border>

        <!-- Employee Info -->
        <Border Background="#000807" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">EMPLOYEE INFO</Label>
        </Border>

        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Background="#fbf9ff">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="10">
                <TextBlock Text="Employee name:" />
                <TextBox x:Name="txtNameBox"/>

                <TextBlock Text="Employee email:" />
                <TextBox x:Name="txtEmailBox"/>

                <TextBlock Text="Employee role:" />
                <TextBox x:Name="txtRoleBox"/>

                <Button Content="Add Employee"
                        Width="100"
                        Click="Save_Click"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      x:Name="EmployeesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" Width="497">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*" />
                    <DataGridTextColumn Header="Email"
                                        Binding="{Binding Email}"
                                        Width="*" />
                </DataGrid.Columns>
                
            </DataGrid>
        </Grid>




        <!-- Leave Requests -->
        <Border Background="#000807" Grid.Row="4" Grid.Column="5">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">LEAVE REQUESTS</Label>
        </Border>
        <ListBox Grid.Row="5" Grid.Column="5"></ListBox>

        <!-- Upcoming Events-->
        <Border Background="#000807" Grid.Row="7" Grid.Column="1">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">UPCOMING EVENTS</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="1"></ListBox>

        <!-- Resignation Requests -->
        <Border Background="#000807" Grid.Row="7" Grid.Column="3">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">RESIGNATION REQUEST</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="3"></ListBox>

        <!-- Payroll Management -->
        <Border Background="#000807" Grid.Row="7" Grid.Column="5">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">PAYROLL MANAGEMENT</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="5"></ListBox>

    </Grid>

</Window>
