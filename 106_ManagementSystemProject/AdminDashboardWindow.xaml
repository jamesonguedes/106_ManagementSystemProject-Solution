<Window x:Class="_106_ManagementSystemProject.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="AdminDashboardWindow" Height="1080" Width="1920">

    <Grid Margin="0,0,0,0">

        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="/pexels-thongtran95-17643093.jpg"
                        Opacity="0.9"/>
        </Grid.Background>

        <!-- Grid definition -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
   
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25"/>
            <ColumnDefinition />
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
            <ColumnDefinition Width="25" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Bar -->
        <Grid Background="#000807" Grid.Row="0" Grid.ColumnSpan="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!--
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="HOME"
                        Click="Home_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="ABOUT US"
                        Click="AboutUs_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="CONTACT US"
                        Click="ContactUs_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="LOGIN"
                        Click="Login_Click"/>
                -->
            </StackPanel>
        </Grid>
        
        <!-- Quick Info Balloons -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#fbf9ff"
                Padding="5"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Registered employees:</TextBox>
        </Border>
        <Border Grid.Row="2" Grid.Column="3"
                 Background="#fbf9ff"
                 Padding="5"
                 BorderBrush="Black"
                 BorderThickness="2"
                 CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Employees on leave:</TextBox>
        </Border>
        <Border Grid.Row="2" Grid.Column="5"
                 Background="#fbf9ff"
                 Padding="5"
                 BorderBrush="Black"
                 BorderThickness="2"
                 CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Pending requests:</TextBox>
        </Border>

        <!-- Employee Info -->
        <Border Background="#000807" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">EMPLOYEE INFO</Label>
        </Border>

        <ScrollViewer Grid.Row="5"
                      Grid.Column="1"
                      Grid.ColumnSpan="3"
                      Background="#fbf9ff"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40">

                <DataGrid x:Name="dgManageEmployee"
                  Height="200"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee ID"
                                    Binding="{Binding Id}"
                                    Width="Auto"/>
                        <DataGridTextColumn Header="First Name"
                                    Binding="{Binding FirstName}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Last Name"
                                    Binding="{Binding LastName}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Phone"
                                    Binding="{Binding Phone}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Job Title"
                                    Binding="{Binding JobTitle}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Department"
                                    Binding="{Binding Department}"
                                    Width="*"/>
                    </DataGrid.Columns>

                </DataGrid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="First Name"/>
                        <TextBox x:Name="txtFirstName"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Last Name"/>
                        <TextBox x:Name="txtLastName"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email"/>
                        <TextBox x:Name="txtEmail"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Phone"/>
                        <TextBox x:Name="txtPhone"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Job Title"/>
                        <TextBox x:Name="txtJobTitle"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Department"/>
                        <TextBox x:Name="txtDepartment"
                           Height="30"
                           Margin="0,5,0,20"/>
                    </StackPanel>

                </Grid>
                <!-- Buttons: Employee Info -->
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <Button Content="Save"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="Save_Click"/>
                    <Button Content="Update"
                            Width="120"
                            Height="40"
                            HorizontalAlignment="Center"
                            Margin="5"
                            Click="Update_Click"/>
                    <Button Content="Delete"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="Delete_Click"/>
                </StackPanel>

                <!-- Display saved employees on list -->
                <TextBlock Text="Saved employees:" Margin="0,20,0,8" />
                <ListBox x:Name="EmployeesListBox"
                         DisplayMemberPath="FirstName + LastName"
                         Height="150" />

            </StackPanel>

        </ScrollViewer>




        <!-- Leave Requests -->
        <Border Background="#000807" Grid.Row="4" Grid.Column="5">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">LEAVE REQUESTS</Label>
        </Border>
        <ListBox Grid.Row="5" Grid.Column="5"></ListBox>

        <!-- Upcoming Events-->
        <Border Background="#000807" Grid.Row="7" Grid.Column="1">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">UPCOMING EVENTS</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="1"></ListBox>

        <!-- Resignation Requests -->
        <Border Background="#000807" Grid.Row="7" Grid.Column="3">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">RESIGNATION REQUEST</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="3"></ListBox>

        <!-- Payroll Management -->
        <Border Background="#000807" Grid.Row="7" Grid.Column="5">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">PAYROLL MANAGEMENT</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="5"></ListBox>

    </Grid>

</Window>
