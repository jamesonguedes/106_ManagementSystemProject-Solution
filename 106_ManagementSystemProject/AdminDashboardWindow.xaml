<Window x:Class="_106_ManagementSystemProject.AdminDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="AdminDashboardWindow" Height="1080" Width="1920">

    <Grid Margin="0,0,0,0">

        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="/pexels-thongtran95-17643093.jpg"
                        Opacity="0.9"/>
        </Grid.Background>

        <!-- Grid definition -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition />
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition />
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <!-- Navigation Bar -->
        <Grid Background="#000807" Grid.Row="0" Grid.ColumnSpan="7">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!--
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="HOME"
                        Click="Home_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="ABOUT US"
                        Click="AboutUs_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="CONTACT US"
                        Click="ContactUs_Click"/>
                <Button Margin="5" BorderThickness="0"  Background="#000807"
                        FontSize="16" Foreground="#FBF9FF"
                        Content="LOGIN"
                        Click="Login_Click"/>
                -->
            </StackPanel>
        </Grid>

        <!-- Quick Info Balloons -->
        <Border Grid.Row="2" Grid.Column="1"
                Background="#fbf9ff"
                Padding="5"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Registered employees:</TextBox>
        </Border>
        <Border Grid.Row="2" Grid.Column="3"
                 Background="#fbf9ff"
                 Padding="5"
                 BorderBrush="Black"
                 BorderThickness="2"
                 CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Employees on leave:</TextBox>
        </Border>
        <Border Grid.Row="2" Grid.Column="5"
                 Background="#fbf9ff"
                 Padding="5"
                 BorderBrush="Black"
                 BorderThickness="2"
                 CornerRadius="10">
            <TextBox FontSize="14"
                     FontWeight="Bold"
                     >Pending requests:</TextBox>
        </Border>

        <!-- Employee Info -->
        <Border Background="#000807" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">EMPLOYEE INFO</Label>
        </Border>

        <ScrollViewer Grid.Row="5"
                      Grid.Column="1"
                      Grid.ColumnSpan="3"
                      Background="#fbf9ff"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="40">

                <DataGrid x:Name="dgManageEmployee"
                  Height="200"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionChanged="dgManageEmployee_SelectionChanged"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee ID"
                                    Binding="{Binding Id}"
                                    Width="Auto"/>
                        <DataGridTextColumn Header="First Name"
                                    Binding="{Binding FirstName}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Last Name"
                                    Binding="{Binding LastName}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Phone"
                                    Binding="{Binding Phone}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Job Title"
                                    Binding="{Binding JobTitle}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Department"
                                    Binding="{Binding Department}"
                                    Width="*"/>
                        <DataGridTextColumn Header="Password"
                                    Binding="{Binding Password}"
                                    Width="*"/>
                    </DataGrid.Columns>

                </DataGrid>

                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="First Name"/>
                        <TextBox x:Name="txtFirstName"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Last Name"/>
                        <TextBox x:Name="txtLastName"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email"/>
                        <TextBox x:Name="txtEmail"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Phone"/>
                        <TextBox x:Name="txtPhone"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Job Title"/>
                        <TextBox x:Name="txtJobTitle"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Department"/>
                        <TextBox x:Name="txtDepartment"
                           Height="30"
                           Margin="0,5,0,20"/>
                    </StackPanel>

                </Grid>
                <!-- Buttons: Employee Info -->
                <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
                    <Button Content="Save"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="Save_Click"/>
                    <Button Content="Update"
                            Width="120"
                            Height="40"
                            HorizontalAlignment="Center"
                            Margin="5"
                            Click="Update_Click"/>
                    <Button Content="Delete"
                            Width="120"
                            Height="40"
                            Click="Delete_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>




        <!-- Leave Requests -->
        <Border Background="#000807" Grid.Row="4" Grid.Column="5">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">LEAVE REQUESTS</Label>
        </Border>
        <ListBox Grid.Row="5" Grid.Column="5">
            <ScrollViewer Grid.Row="5"
               Grid.Column="5"
               Grid.ColumnSpan="3"
               Background="#fbf9ff"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled">

                <StackPanel Width="585">
                    <DataGrid x:Name="dgLeaveRequest"
                      Height="300"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Margin="0,0,0,20">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                             Binding="{Binding Id}"
                             Width="Auto"/>

                            <DataGridTextColumn Header="Employee Name"
                             Binding="{Binding Name}"
                             Width="*"/>

                            <DataGridTextColumn Header="Leave Type"
                             Binding="{Binding LeaveType}"
                             Width="*"/>

                            <DataGridTextColumn Header="Start Date"
                             Binding="{Binding StartDate}"
                             Width="*"/>

                            <DataGridTextColumn Header="End Date"
                             Binding="{Binding EndDate}"
                             Width="*"/>
                            
                            <DataGridTextColumn Header="Total Hours"
                             Binding="{Binding HoursRequested}"
                             Width="*"/>

                            <DataGridTextColumn Header="Status"
                             Binding="{Binding Status}"
                             Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>
                    
                    <StackPanel Orientation="Horizontal" Width="255">
                        <Button Content="Approve"
                     Width="120"
                     Height="40"
                     HorizontalAlignment="Center"
                     Margin="5,0,0,0"
                     Click="Approve_Click"/>

                        <Button Content="Reject"
                     Width="120"
                     Height="40"
                     HorizontalAlignment="Center"
                     Margin="5,0,0,0"
                     Click="Reject_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ListBox>


        <!-- Upcoming Events-->
        <Border Background="#000807" Grid.Row="7" Grid.Column="1">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">UPCOMING EVENTS</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="1"></ListBox>

        <!-- Resignation Requests -->
        <Border Background="#000807" Grid.Row="7" Grid.Column="3">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">RESIGNATION REQUEST</Label>
        </Border>
        <ListBox Grid.Row="8" Grid.Column="3"></ListBox>

        <!-- Payroll Management -->
        <Border Background="#000807" Grid.Row="7" Grid.Column="5">
            <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">PAYROLL MANAGEMENT</Label>
        </Border>
        <Grid Grid.Row="8"
        Grid.Column="5">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                      Background="#fbf9ff"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
                <StackPanel Width="576" Height="583">

                    <!-- Payroll Management DataGrid -->
                    <DataGrid x:Name="dgPayrollManagement"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HorizontalAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" Height="219" Width="577">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Employee ID"
                            Binding="{Binding EmployeeID}"
                            Width="2*"/>

                            <DataGridTextColumn Header="Employee Name"
                            Binding="{Binding EmployeeName}"
                            Width="2*"/>

                            <DataGridTextColumn Header="Gross Salary"
                            Binding="{Binding GrossSalary}"
                            Width="*"/>

                            <DataGridTextColumn Header="Tax"
                            Binding="{Binding Tax}"
                            Width="*"/>

                            <DataGridTextColumn Header="Net Salary"
                            Binding="{Binding NetSalary}"
                            Width="*"/>

                        </DataGrid.Columns>

                    </DataGrid>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Employee ID"/>
                        <TextBox x:Name="txtEmployeeID"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Employee Name"/>
                        <TextBox x:Name="txtEmployeeName"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Gross Salary"/>
                        <TextBox x:Name="txtGrossSalary"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="Tax"/>
                        <TextBox x:Name="txtTax"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Net Salary"/>
                        <TextBox x:Name="txtNetSalary"
                           Height="30"
                           Margin="0,5,0,10"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Width="390">
                        <Button Content="Add Payroll"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="AddPayroll_Click"/>

                        <Button Content="Update Payroll"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="UpdatePayroll_Click"/>

                        <Button Content="Delete Payroll"
                            Width="120"
                            Height="40"
                            Margin="5"
                            Click="DeletePayroll_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>


        </Grid>


    </Grid>

</Window>
