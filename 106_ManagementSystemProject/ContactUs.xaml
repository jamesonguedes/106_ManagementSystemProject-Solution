<Page x:Class="_106_ManagementSystemProject.ContactUs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_106_ManagementSystemProject"
      mc:Ignorable="d" 
      Title="ContactUs" Height="600" Width="1000">

    <ListBox Height="538" Width="866"  HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Height="532" Width="855">
            
            <TextBlock Text="Contact Us"
           FontSize="30"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Margin="0,10,0,20"/>

            <TextBlock 
             Text="Name"
             FontSize="20"
             FontWeight="Bold"
             Margin="0,20,0,10"/>

            <TextBox 
             x:Name="txtName"
             Height="35"/>

            <TextBlock 
              Text="Email"
              FontSize="20"
              FontWeight="Bold"
              Margin="0,20,0,10"/>

            <TextBox 
              x:Name="txtEmail"
              Height="35"/>

            <TextBlock Text="Write us a message"
              FontWeight="Bold"
              FontSize="20"       
              Margin="0,20,0,10"/>

            <TextBox x:Name="txtMessage"
             Height="109"
             Width="814"
             TextWrapping="Wrap"
             AcceptsReturn="True"/>
            
            <Button 
              Content="Send"
              Width="250"
              Height="40"
              Margin="0,20,0,20"
              Foreground="#FBF9FF"
              Background="#9395D3"
              Click="Submit_Click"/>
        </StackPanel>
    </ListBox>
</Page>
