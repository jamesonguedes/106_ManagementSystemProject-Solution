<Window x:Class="_106_ManagementSystemProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="Login Page" Height="600" Width="1000"
        FontFamily="Calibri" FontSize="20"
        Background="green">
    <Grid Margin="0,0,20,0">
        
        <!-- Grid definition -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <!-- Application name -->
        <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,0,0">HR Management System</TextBlock>
        <Frame Grid.Column="1" Grid.Row="1" Name="MainArea" Source="Login.xaml">
            
        </Frame>

    </Grid>
</Window>
