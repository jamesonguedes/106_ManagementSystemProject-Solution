<Page x:Class="_106_ManagementSystemProject.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_106_ManagementSystemProject"
      mc:Ignorable="d" 
      Title="Login" Height="600" Width="1000">

    <StackPanel>
        <ListBox Height="479" Width="942">
            <TextBlock 
           Text="Login Page"
           FontWeight="Bold"
           FontSize="30"
           />


            <TextBlock 
           Text="Username"
           FontSize="20"
           FontWeight="Bold"/>

            <TextBox 
         x:Name="txtUsername"
         Height="35"
         Margin="0,5,0,20" Width="837"/>

            <TextBlock 
           Text="Password"
           FontSize="20"
           FontWeight="Bold"/>

            <PasswordBox 
             x:Name="txtPassword"
             Height="35"
             Margin="0,5,0,20" Width="832"/>

            <TextBlock
            Text="Forgot your password?"
            FontSize="16"
            Foreground="White"
            HorizontalAlignment="Center"
            Margin="0,10,0,20"/>

            <Button 
            Content="Login"
        Foreground="#FBF9FF"
        Background="#9395D3"
        Width="250"
        Height="40"
        Margin="0,5,0,20"
        Click="AdminDashboard_Click"/>
        </ListBox>
    </StackPanel>
</Page>
