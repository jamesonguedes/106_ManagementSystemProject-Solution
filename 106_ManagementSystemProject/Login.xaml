<Page x:Class="_106_ManagementSystemProject.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_106_ManagementSystemProject"
      mc:Ignorable="d"
      Title="Login" Height="1080" Width="1920">

    <StackPanel VerticalAlignment="Center" Height="628">

        <TextBlock Text="Login"
           FontWeight="Bold"
           FontSize="50"
           HorizontalAlignment="Center"
           Margin="0,0,0,30"/>

        <TextBlock Text="Username"
           FontWeight="Bold"
           FontSize="30" 
           Width="1474"/>

        <TextBox x:Name="txtUsername"
           Height="50"
           Width="1476"
           Margin="0,5,0,20"/>

        <TextBlock Text="Password"
           FontWeight="Bold"
           FontSize="30"
           Width="1474"/>

        <PasswordBox x:Name="txtPassword"
             Height="50"
             Width="1476"
             Margin="0,5,0,20"/>

        <Button Content="Login"
        FontSize="20"
        Width="250"
        Height="40"
        Margin="0,5,0,20"
        Click="Login_Click"/>

        <Button Content="Back to Home"
        FontSize="20"
        Width="250"
        Height="40"
        Click="Backtohome_Click"/>

    </StackPanel>

</Page>
