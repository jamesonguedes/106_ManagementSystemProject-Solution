<Page x:Class="_106_ManagementSystemProject.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_106_ManagementSystemProject"
      mc:Ignorable="d" 
      Title="Login" Height="600" Width="1000">

    <StackPanel VerticalAlignment="Center"> 
        <TextBlock 
           Text="Login"
           FontWeight="Bold"
           FontSize="30"
           Foreground="White"
           HorizontalAlignment="Center"
           Margin="0,20,0,30"/>

        <TextBlock 
           Text="Username"
           FontSize="20"
           FontWeight="Bold"
           Foreground="White"/>

        <TextBox 
         x:Name="txtUsername"
         Height="35"
         Margin="0,5,0,20"/>

        <TextBlock 
           Text="Password"
           FontSize="20"
           FontWeight="Bold"
           Foreground="White"/>

        <PasswordBox 
             x:Name="txtPassword"
             Height="35"
             Margin="0,5,0,20"/>

        <Button 
        Content="Login"
        Foreground="#FBF9FF"
        Background="#9395D3"
        Width="250"
        Height="40"
        Margin="0,5,0,20"
        Click="Login_Click"/>

        <Button 
        Content="Back to Home"
        Foreground="#FBF9FF"
        Background="#9395D3"
        Width="250"
        Height="40"
        Click="Backtohome_Click"/>
    </StackPanel>
    
</Page>
