<Page x:Class="_106_ManagementSystemProject.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_106_ManagementSystemProject"
      mc:Ignorable="d" 
      Title="Login" Height="600" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.ColumnSpan="2" Margin="5,50,0,73" HorizontalAlignment="Left" Width="990"/>
        <StackPanel Margin="0,96,0,73" Width="444" HorizontalAlignment="Center">

            <TextBlock 
             Text="Admin Login"
             FontWeight="Bold"
             FontSize="30"
             HorizontalAlignment="Center"/>

            <TextBlock 
             Text="Admin Email"
             FontSize="20"
             FontWeight="Bold"
             Margin="0,20,0,10"/>

            <TextBox 
             x:Name="txtAdminEmail"
             Height="35"
             Margin="0,5,0,20"/>

            <TextBlock 
            Text="Password"
            FontSize="20"
            FontWeight="Bold"
            Margin="0,20,0,10"/>

            <PasswordBox 
              x:Name="txtAdminPassword"
              Height="35"
              Margin="0,5,0,20"/>

            <TextBlock
             Text="Forgot your password?"
             FontSize="16"
             HorizontalAlignment="Center"
             Margin="0,20,0,20"/>

            <Button 
             Content="Login"
             Foreground="#FBF9FF"
             Background="#9395D3"
             Width="250"
             Height="40"
             Margin="0,20,0,30"
             Click="AdminDashboard_Click"/>
        </StackPanel>



        <StackPanel Width="444" Margin="0,96,0,69" HorizontalAlignment="Center" Grid.Column="1">
            <TextBlock 
                 Text="Employee Login"
                 FontWeight="Bold"
                 FontSize="30"
                 HorizontalAlignment="Center"/>

            <TextBlock 
                 Text="Employee Email"
                 FontSize="20"
                 FontWeight="Bold"
                 Margin="0,20,0,10"/>

            <TextBox 
                 x:Name="txtEmployeeEmail"
                 Height="35"
                 Margin="0,5,0,20" 
                 Width="441"/>

            <TextBlock 
                 Text="Password"
                 FontSize="20"
                 FontWeight="Bold"
                 Margin="0,20,0,10"/>

            <PasswordBox 
                 x:Name="txtEmployeePassword"
                 Height="35"
                 Margin="0,5,0,20"/>

            <TextBlock
                 Text="Forgot your password?"
                 FontSize="16"
                 HorizontalAlignment="Center"
                 Margin="0,20,0,20"/>

            <Button 
                 Content="Login"
                 Foreground="#FBF9FF"
                 Background="#9395D3"
                 Width="250"
                 Height="40"
                 Margin="0,20,0,30"
                 Click="EmployeeDashboard_Click"/>
        </StackPanel>
    </Grid>
</Page>
