<Window x:Class="_106_ManagementSystemProject.EmployeeDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="EmployeeDashboardWindow" Height="1080" Width="1920">

    <Grid Margin="0,0,0,0">

        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="/pexels-thongtran95-17643093.jpg"
                        Opacity="0.9"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <!-- ZERO Left Margin -->
            <ColumnDefinition Width="40" />
            <!-- ONE Content Area-->
            <ColumnDefinition  Width="*"/>
            <!-- TWO Right Margin-->
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <!-- ZERO Top Margin-->
            <RowDefinition Height="40" />
            <!-- ONE Ballons area -->
            <RowDefinition Height="*" />
            <!-- TWO space -->
            <RowDefinition Height="25" />
            <!-- TREE leave request border -->
            <RowDefinition Height="*" />
            <!-- FOUR leave request area / Personal info -->
            <RowDefinition Height="*" />
            <!-- FIVE space / Personal info -->
            <RowDefinition Height="25" />
            <!-- SIX new request border / Personal info -->
            <RowDefinition Height="*" />
            <!-- SEVEN new request area / Personal info -->
            <RowDefinition Height="*" />
            <!-- EIGHT space -->
            <RowDefinition Height="25" />
            <!-- NINE borders: events, schedule, clock -->
            <RowDefinition Height="*" />
            <!-- TEN events, schedule, clock aread -->
            <RowDefinition Height="*" />
            <!-- ELEVEN bottom margin -->
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <TextBlock Text="EMPLOYEE DASHBOARD TEST"
           Grid.Row="0"
           Grid.Column="1"
           FontSize="24"
           FontWeight="Bold"
           Foreground="Red"
           HorizontalAlignment="Center"/>

        <!-- Top Ballons -->
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Annual Leave Balloon -->
            <Border Grid.Column="0"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="25"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
            <!-- Annual Leave Balloon -->
            <Border Grid.Column="1"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Sick Leave</TextBox>
            </Border>
            <!-- Grievance Balloon -->
            <Border Grid.Column="2"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
            <!-- Non-paid leave Balloon -->
            <Border Grid.Column="3"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
        </Grid>

    </Grid>
</Window>
