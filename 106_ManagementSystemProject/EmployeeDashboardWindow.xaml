<Window x:Class="_106_ManagementSystemProject.EmployeeDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="EmployeeDashboardWindow" Height="1080" Width="1920">

    <Grid Margin="0,0,0,0">

        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="/pexels-thongtran95-17643093.jpg"
                        Opacity="0.9"/>
        </Grid.Background>

        <!-- Grid Columns Definition -->
        <Grid.ColumnDefinitions>
            <!-- ZERO Left Margin -->
            <ColumnDefinition Width="40" />
            <!-- ONE Content Area-->
            <ColumnDefinition  Width="*"/>
            <!-- TWO Right Margin-->
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <!-- Grid Rows Definition -->
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="25" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Top Ballons -->
        <Grid Height="100"  Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Annual Leave Balloon -->
            <Border Grid.Column="0"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>

            </Border>
            <!-- Annual Leave Balloon -->
            <Border Grid.Column="1"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Sick Leave</TextBox>
            </Border>
            <!-- Grievance Balloon -->
            <Border Grid.Column="2"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
            <!-- Non-paid leave Balloon -->
            <Border Grid.Column="3"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
        </Grid>

        <!-- Leave Requests and Personal info -->
        <Grid Grid.Column="1" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Leave Request -->
            <Border Background="#000807"
                    Grid.Column="0"
                    Grid.Row="0">
                <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">LEAVE REQUEST</Label>
            </Border>
            <ScrollViewer Background="#fbf9ff"
                            Grid.Column="0"
                            Grid.Row="1"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="40">

                    <!-- Use this later:  SelectionChanged="dgLeaveRequests_SelectionChanged" -->
                    <DataGrid x:Name="dgLeaveRequests"
                                Height="200"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                Margin="0,0,0,20">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Leave Type"
                                        Binding="{Binding LeaveType}"
                                        Width="Auto"/>
                            <DataGridTextColumn Header="Start Date"
                                        Binding="{Binding StartDate}"
                                        Width="*"/>
                            <DataGridTextColumn Header="End Date"
                                        Binding="{Binding EndDate}"
                                        Width="*"/>
                            <DataGridTextColumn Header="Hours Requested"
                                        Binding="{Binding Email}"
                                        Width="*"/>
                            <DataGridTextColumn Header="Status"
                                        Binding="{Binding Phone}"
                                        Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Request Display area-->
            <Border Background="#000807"
                Grid.Column="0" Grid.Row="3">
                <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">NEW REQUEST</Label>
            </Border>

            <!-- New Request Display area-->
            <Border Background="#fbf9ff"
                    Grid.Column="0"
                    Grid.Row="3" Margin="0,45,0,5" Grid.RowSpan="2">
                <Grid HorizontalAlignment="Center"
                      Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Grid.Row="0">
                        <TextBlock Text="Leave Type"/>
                        <ComboBox x:Name="txtLeaveType"
                                  Height="30"
                                  Margin="5,5,5,0">
                            <ComboBoxItem Content="Annual Leave"/>
                            <ComboBoxItem Content="Sick Leave"/>
                            <ComboBoxItem Content="Unpaid Leave"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Grid.Row="0">
                        <TextBlock Text="Start Date"/>
                        <DatePicker x:Name="txtStartDate"
                                    Height="30"
                                    Margin="5,5,5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Grid.Row="0">
                        <TextBlock Text="End Date"/>
                        <DatePicker x:Name="txtEndDate"
                                    Height="30"
                                    Margin="5,5,5,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Grid.Row="0">
                        <TextBlock Text="HoursRequested"/>
                        <TextBox x:Name="txtHoursRequested"
                                 Height="30"
                                 Margin="5,5,5,0"/>
                    </StackPanel>

                    <!--
                    <StackPanel Grid.Column="4" Grid.Row="0">
                        <TextBlock Text="Status"/>
                        <TextBox x:Name="txtStatus"
                        Height="30"
                        Margin="0,5,0,10"/>
                    
                    </StackPanel>
                    -->
                    
                    <StackPanel Grid.Column="0"
                                Grid.Row="4"
                                Grid.ColumnSpan="5"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button Content="Request"
                                Width="120"
                                Height="40"
                                Margin="5,10,5,5"
                                Click="RequestLeeave_Click"/>
                        <Button Content="Update"
                                Width="120"
                                Height="40"
                                HorizontalAlignment="Center"
                                Margin="5,10,5,5"
                                Click="UpdateLeave_Click"/>
                        <Button Content="Delete"
                                Width="120"
                                Height="40"
                                Margin="5,10,5,5"
                                Click="DeleteLeave_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Personal info -->
            <Border Background="#fbf9ff"
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    CornerRadius="25"
                    Margin="25">
                <Grid>
                    <!-- Grid definition for personal info -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Image and name -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Margin="0,10,0,5">
                        <Ellipse Height="200"
                                 Width="200"
                                 HorizontalAlignment="Center">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="/pexels-amirsaeiddehghan-13108275.jpg"
                                        Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock x:Name="txtEmployeeName"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#000807"
                                   Margin="0,10,0,5"/>
                    </StackPanel>
                    <!-- Role, email, phone, department-->
                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="20">
                        <TextBlock x:Name="txtEmployeeId"
                                   FontSize="20"
                                   Foreground="#000807"
                                   Margin="0,0,0,18"/>
                        <TextBlock x:Name="txtEmployeeRole"
                                   FontSize="20"
                                   Foreground="#000807"
                                   Margin="0,0,0,18"/>
                        <TextBlock x:Name="txtEmployeeEmail"
                                   FontSize="20"
                                   Margin="0,0,0,18"
                                   Foreground="#000807"/>
                        <TextBlock x:Name="txtEmployeePhone"
                                   FontSize="20"
                                   Foreground="#000807"
                                   Margin="0,0,0,18"/>
                        <TextBlock x:Name="txtEmployeeDepartment"
                                   FontSize="20"
                                   Foreground="#000807"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2">
                        <TextBox TextWrapping="Wrap"
                                 FontSize="15"
                                 Foreground="#000807"
                                 Margin="25,20,25,20">
                            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.
                        </TextBox>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Upcoming Events -->
                <Border Background="#000807"
                Grid.Column="0" Grid.Row="0">
                    <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">UPCOMING EVENTS</Label>
                </Border>
                <Border Background="#fbf9ff"
                    Grid.Column="0"
                    Grid.Row="1">
                    <TextBox>Under Maintenance</TextBox>
                </Border>

                <!-- Work Schedule -->
                <Border Background="#000807"
                Grid.Column="2" Grid.Row="0">
                    <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">WORK SCHEDULE</Label>
                </Border>
                <Border Background="#fbf9ff"
                    Grid.Column="2"
                    Grid.Row="1">
                    <TextBox>Under Maintenance</TextBox>
                </Border>

                <!-- Clock -->
                <Border Background="#000807"
                Grid.Column="4" Grid.Row="0">
                    <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">CLOCK</Label>
                </Border>
                <Border Background="#fbf9ff"
                    Grid.Column="4"
                    Grid.Row="1">
                    <TextBox>
                        
                        
                        MESSAGE FOR TESTING
                        CAN BE DELETED

                    </TextBox>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Window>
