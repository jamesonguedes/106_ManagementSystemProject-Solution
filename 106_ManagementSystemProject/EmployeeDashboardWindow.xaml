<Window x:Class="_106_ManagementSystemProject.EmployeeDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_106_ManagementSystemProject"
        mc:Ignorable="d"
        Title="EmployeeDashboardWindow" Height="1080" Width="1920">

    <Grid Margin="0,0,0,0">

        <!-- Background Image -->
        <Grid.Background>
            <ImageBrush ImageSource="/pexels-thongtran95-17643093.jpg"
                        Opacity="0.9"/>
        </Grid.Background>

        <!-- Grid Columns Definition -->
        <Grid.ColumnDefinitions>
            <!-- ZERO Left Margin -->
            <ColumnDefinition Width="40" />
            <!-- ONE Content Area-->
            <ColumnDefinition  Width="*"/>
            <!-- TWO Right Margin-->
            <ColumnDefinition Width="40" />
        </Grid.ColumnDefinitions>

        <!-- Grid Rows Definition -->
        <Grid.RowDefinitions>
            <RowDefinition Height="25" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>

        <!-- Top Ballons -->
        <Grid Height="100"  Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Annual Leave Balloon -->
            <Border Grid.Column="0"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>

            </Border>
            <!-- Annual Leave Balloon -->
            <Border Grid.Column="1"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Sick Leave</TextBox>
            </Border>
            <!-- Grievance Balloon -->
            <Border Grid.Column="2"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
            <!-- Non-paid leave Balloon -->
            <Border Grid.Column="3"
                    Background="#fbf9ff"
                    Margin="15"
                    Padding="5"
                    BorderBrush="Black"
                    BorderThickness="2"
                    CornerRadius="10" >
                <TextBox FontSize="24"
                         HorizontalContentAlignment="Center"
                         FontWeight="Bold">Annual Leave</TextBox>
            </Border>
        </Grid>

        <!-- Leave Requests and Personal info -->
        <Grid Grid.Column="1" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Leave Request -->
            <Border Background="#000807"
                    Grid.Column="0"
                    Grid.Row="0">
                <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">LEAVE REQUEST</Label>
            </Border>
            <Border Background="#fbf9ff"
                    Grid.Column="0"
                    Grid.Row="1">
                <TextBox>Under Maintenance</TextBox>
            </Border>

            <!-- New Request -->
            <Border Background="#000807"
                Grid.Column="0" Grid.Row="3">
                <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">NEW REQUEST</Label>
            </Border>
            <Border Background="#fbf9ff"
                    Grid.Column="0"
                    Grid.Row="4">
                <TextBox>Under Maintenance</TextBox>
            </Border>

            <!-- Personal info -->
            <Border Background="#fbf9ff"
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    CornerRadius="10"
                    Margin="5">
                <TextBox>Under Maintenance</TextBox>
            </Border>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="25"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Upcoming Events -->
                <Border Background="#000807"
                Grid.Column="0" Grid.Row="0">
                    <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">NEW REQUEST</Label>
                </Border>
                <Border Background="#fbf9ff"
                    Grid.Column="0"
                    Grid.Row="1">
                    <TextBox>Under Maintenance</TextBox>
                </Border>

                <!-- Work Schedule -->
                <Border Background="#000807"
                Grid.Column="2" Grid.Row="0">
                    <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">NEW REQUEST</Label>
                </Border>
                <Border Background="#fbf9ff"
                    Grid.Column="2"
                    Grid.Row="1">
                    <TextBox>UPCOMING EVENTS</TextBox>
                </Border>

                <!-- Clock -->
                <Border Background="#000807"
                Grid.Column="4" Grid.Row="0">
                    <Label  FontSize="14"
                    Foreground="#FBF9FF"
                    HorizontalAlignment="Left">CLOCK</Label>
                </Border>
                <Border Background="#fbf9ff"
                    Grid.Column="4"
                    Grid.Row="1">
                    <TextBox>Under Maintenance</TextBox>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Window>
