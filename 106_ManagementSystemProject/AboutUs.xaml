<Page x:Class="_106_ManagementSystemProject.AboutUs"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_106_ManagementSystemProject"
      mc:Ignorable="d"
      Title="AboutUs" Height="600" Width="1000">

    <ListBox Height="422" Width="866"  HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Height="416" Width="855">
            <TextBlock Text="About Us"
           FontSize="30"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Margin="0,10,0,30"/>

            <Image Source="/Group 85.png"
                   Width="213"
                   Height="125"
                   Stretch="Uniform"/>

            <TextBlock TextWrapping="Wrap"
            TextAlignment="Center"
            FontFamily="Calibri"
            FontStyle="Italic"
            FontSize="18"
            Width="659"
            Margin="0,20,0,0">
                <Run Text="NZFTC is a leading organization in the field of Finances and Trade. We are dedicated to streamline our human resource management processes and improve our operational efficiency and effectiveness."/>
            </TextBlock>
            
            <Button 
             Content="Contact us"
             Margin="0,20,0,30"
             Width="250"
             Height="40"
             HorizontalAlignment="Center"
             Foreground="White"
             Background="#9395D3"
             Click="ContactUsButton_Click"/>
        </StackPanel>
    </ListBox>
</Page>
